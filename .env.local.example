# ---------------------------------------------------------------------------
# testsiteanik — environment configuration (EXAMPLE / placeholders only)
#
# Copy this file to .env.local and fill in the real values:
#     cp .env.local.example .env.local
#
# .env.local is git-ignored; this example file is tracked. Never put a real key
# in this file. Add the same three variables to the Vercel project under
# Settings > Environment Variables, enabled for ALL environments
# (Production, Preview, Development).
#
# None of these may ever be prefixed with NEXT_PUBLIC_. A NEXT_PUBLIC_ variable
# is inlined into the browser bundle, which would publish the Graph Single key.
# ---------------------------------------------------------------------------

# Optimizely Graph GraphQL endpoint.
OPTIMIZELY_GRAPH_URL=https://cg.optimizely.com/content/v2

# Graph Single key. Find it in the CMS dashboard under "Render Content"
# (Dashboard > Render Content > Graph keys). Server-only secret: it is used in the
# Authorization header from server code and must never reach the browser, a URL,
# a log line, or an error message shown to a user. Rotate it in the CMS dashboard
# if it is ever exposed.
OPTIMIZELY_GRAPH_SINGLE_KEY=your-graph-single-key-here

# Full origin of your CMS SaaS instance — scheme + host, no trailing slash, no path.
# Used for the preview communication injector script and for the exact
# frame-ancestors / frame-src allowlist that lets the CMS embed this site.
OPTIMIZELY_CMS_HOST=https://example.cms.optimizely.com
